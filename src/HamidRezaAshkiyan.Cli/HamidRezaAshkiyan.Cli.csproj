<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hamidrezaashkiyan</ToolCommandName>
    <PackageId>HamidRezaAshkiyan</PackageId>
    <Description>CLI for HamidReza 'Ashkan' Ashkiyan's portfolio, blog, resume, projects, and profiles - Run with 'dnx hamidrezaashkiyan'</Description>
    <Authors>HamidReza Ashkiyan</Authors>
    <PackageProjectUrl>https://github.com/HamidRezaAshkiyan/ashkan-card-dnx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HamidRezaAshkiyan/ashkan-card-dnx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet-tool;cli;business-card;dnx;hamidrezaashkiyan;ashkan</PackageTags>
    <RollForward>Major</RollForward>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>1.1.0</Version>
    <ReleaseNotes>Sync upstream v1.26-v1.27 (help command, -i REPL fix, Node 24 Actions), add website/resume/projects commands, and add Engineering Blog RSS to recent activity.</ReleaseNotes>
    <RootNamespace>HamidRezaAshkiyan.Cli</RootNamespace>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);TimeWarp.Nuru.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageReference Include="TimeWarp.Nuru" Version="3.0.0-beta.68" />
  </ItemGroup>

</Project>
